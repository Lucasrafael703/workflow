# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# SMTP settings used by django.core.mail. In dev, EMAIL_BACKEND defaults to
# the console backend, so these can stay empty.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=service-account@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Name of the django.contrib.auth Group treated as "administrators" for
# notification/e-mail fan-out.
ADMIN_GROUP_NAME=ADMIN

# Production only (config.settings.prod), e.g. postgres://user:pass@host:5432/dbname
# DATABASE_URL=
